# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================
# Iberdrola API Configuration
# ============================================
# Device ID for API requests (UUID format)
DEVICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================
# Charger Configuration
# ============================================
# Charger IDs to monitor (comma-separated)
# Use find_chargers.py to discover charger IDs near your location
# Example IDs below are fictional
CHARGER_IDS=1234,5678,9012

# ============================================
# Location Configuration  
# ============================================
# Your location coordinates (for charger searches)
# Example: Madrid, Spain (Plaza Mayor)
LATITUDE=40.4155
LONGITUDE=-3.7074

# ============================================
# Monitoring Configuration
# ============================================
# Scan interval in seconds (default: 60)
CHECK_INTERVAL=60

# Random deviation applied to each scan so the polling is not perfectly
# regular. Percentage of the interval (0 disables it) and minimum in seconds.
SCAN_JITTER_PCT=15
SCAN_JITTER_MIN=5

# ============================================
# Authentication (Optional - for favorites/history)
# ============================================
# Your Iberdrola account credentials
# Only needed if you want to access authenticated features
# IBERDROLA_USER=your_email@example.com
# IBERDROLA_PASS=your_password

# ============================================
# Automatic MFA (Optional - for fully automated login)
# ============================================
# Gmail IMAP credentials for reading MFA codes automatically
# Requires: 
#   1. Enable IMAP in Gmail: Settings > See all settings > Forwarding and POP/IMAP
#   2. Create App Password: https://myaccount.google.com/apppasswords
#      (Requires 2FA enabled on Google account)
#
# IMAP_USER=your_email@gmail.com
# IMAP_PASS=your_app_password_here

# ============================================
# Iberdrola App Version
# ============================================
# Version of the Iberdrola app to emulate in API requests
# Can also be changed at runtime via the bot's "📱 Versión" button
IBERDROLA_APP_VERSION=4.36.8

# ============================================
# Connector Preference (For reservations)
# ============================================
# Preferred connector type when multiple are available on the same post
# Common values: Mennekes, Schuko, Tipo2-cable
# If set, the bot will prioritize this type when reserving
# PREFERRED_CONNECTOR_TYPE=Mennekes

# ============================================
# Charger hunt (auto reserve when one becomes free)
# ============================================
# Initial scan interval while hunting, in seconds (can be changed from the bot)
# HUNT_INTERVAL=60
# Lowest interval allowed, to avoid hammering the API
# HUNT_MIN_INTERVAL=30
# The hunt switches itself off after this many minutes
# HUNT_MAX_MINUTES=180

# Minutes of someone else's reservation to highlight (free cancel, expiry)
# RESERVATION_MARKS_MIN=13,30

# ============================================
# HTTP API (optional, for a mobile app). See API.md
# ============================================
# Disabled unless set. At least 32 characters, generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Publish it only behind a TLS reverse proxy, ideally requiring client certificates.
# API_TOKEN=
# API_PORT=8090

# ============================================
# Redsys Payment Configuration (For reservations)
# ============================================
# Android license key extracted from Iberdrola APK
# This is required for processing reservation payments
# REDSYS_ANDROID_LICENSE=your_redsys_android_license
